# Copy this file to ".env" and fill in your own values. NEVER commit ".env".

# "development" locally, "production" on the live server.
APP_ENV=development

# A long random string that signs login cookies. Create one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Free key from Google AI Studio.
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.5-flash-lite

# Leave empty to use the local SQLite file. For PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/library

# Production only: must be true when the site uses HTTPS (it is on by default there).
# COOKIE_SECURE=true

# Optional: creates the first staff account at startup when no staff exist yet.
# ADMIN_USERNAME=librarian
# ADMIN_PASSWORD=choose-a-strong-password